{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/index.js"
        },
        {
            "source": "/((?!api/|_next/|.*\\..*).*)",
            "destination": "/client/dist/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/client/dist/$1"
        }
    ]
}